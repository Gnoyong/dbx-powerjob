{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "检查 TypeScript",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "typecheck"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "构建插件前端",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "打包 DBX 插件",
      "type": "process",
      "command": "node",
      "args": [
        "node_modules/@dbx-app/plugin-cli/bin/dbx-plugin.js",
        "package",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "构建插件前端",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "发布新版本",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/release.mjs",
        "${input:releaseVersion}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "检查 TypeScript",
        "构建插件前端"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "releaseVersion",
      "type": "promptString",
      "description": "请输入新版本号（不含 v）",
      "default": "0.1.18"
    }
  ]
}
